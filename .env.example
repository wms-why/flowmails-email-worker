# JWT secret for developer API key authentication
#随便填一串字符串，例如: JWT_SECRET=your-secret-here
JWT_SECRET=

# 程序版本号，例如: VERSION=1.0.0
VERSION=1.0.0

# 是否启用 Drizzle ORM 日志 (true/false)
orm_log=false

# 邮件域名，可配置多个，例如: domain=["example1.com","example2.com"]
# domain=[]

# 管理员邮箱，例如: admin@example.com
# admin=

# Cloudflare Workers bindings (injected by the runtime — no need to set manually locally)
# EMAIL=     # email routing binding
# r2=        # R2 bucket binding
# db=        # D1 database binding
# kv=        # KV namespace binding
# assets=    # static assets binding (optional)
